{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Ouvrir Terminal API",
            "type": "shell",
            "command": "cd \"${workspaceFolder}/api\" && exec bash --init-file <(echo \"source ~/.bashrc; source .venv/bin/activate\")",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "runOptions": {
                "runOn": "folderOpen"
            }
        }
    ]
}