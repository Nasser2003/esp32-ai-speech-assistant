#################################################
# Ollama Configuration ##########################
#################################################
OLLAMA_URL=http://host.containers.internal:11434
CHAT_MODEL=llama3.2


#################################################
# ESP32 Configuration ###########################
#################################################


#################################################
# API Configuration #############################
#################################################
API_PORT=5000
API_HOST=
API_WEBSOCKET_PATH=/ws/esp32

# audio stream is split into 2 seconds of audio at 16kHz, 16-bit PCM and sent to the transcription model
TRANSCRIPTION_CHUNK_SIZE=64_000
# glide audio stream every 1 second of audio, to avoid missing words in the transcription cut
TRANSCRIPTION_WINDOW_SIZE=32_000
TRANS_MODEL=small

# redis key prefixes key(prefix:<id>). Warning! Keep ':' at the end for string split
# These keys can be seen as queue identifier for each audio stream session.
# - identify the voice language
REDIS_PREFIX_LANGUAGE=audio_language:
# - recorded audio
REDIS_PREFIX_RECORD=audio_record:
# - transcription
REDIS_PREFIX_TRANSCRIPTION=audio_trans:
# - ai text response
REDIS_PREFIX_AI_TEXT=ai_text:
# - ai audio response
REDIS_PREFIX_AI_TTS=ai_tts:

# Signals name about client and api state to synchronize async tasks
# - signal telling that the client started recording audio stream
RECORDING_START=/RECORDING START
RECORDING_END=/RECORDING END
# - start transcription of the audio stream
TRANSCRIPTION_START=/TRANSCRIPTION START
TRANSCRIPTION_END=/TRANSCRIPTION END
# - start sending ai textual answer to the client
AI_TEXT_START=/AI TEXT START
AI_TEXT_END=/AI TEXT END
# - start sending ai audio answer to the client
AI_TTS_START=/AI TTS START
AI_TTS_END=/AI TTS END
# - signal telling to the client that the api websocket connection is closing
WEBSOCKET_CLOSE=/WEBSOCKET CLOSE

# "en" or "fr" or "auto", The voice transcriptor can detect the language automatically if set to "auto"
VOICE_LANGUAGE=auto


#################################################
# POSTGRES Configuration ########################
#################################################
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

POSTGRES_HOST=postgres
POSTGRES_PORT=5432


#################################################
# REDIS Configuration ###########################
#################################################
REDIS_HOST=redis
REDIS_PORT=6379
# the values in memory database expire after 2 minutes
TTL_EXPIRE_TIME=120